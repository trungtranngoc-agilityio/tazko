[Unit]
Description=Tazko nightly backup
After=tazko.service

[Service]
Type=oneshot
User=tazko
Group=tazko
EnvironmentFile=/etc/tazko/tazko.env
ExecStart=/opt/tazko/current/tazko backup --data /var/lib/tazko/data --to /var/backups/tazko --keep-days 30
ExecStartPost=/opt/tazko/current/tazko check --data /var/backups/tazko/latest
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/tazko
ReadOnlyPaths=/var/lib/tazko
