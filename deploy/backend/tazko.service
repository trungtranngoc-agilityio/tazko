[Unit]
Description=Tazko API
After=network.target
# No start limit: tazko-release restarts, stops and starts the service during a
# rollback, and a refused start would leave it down (RestartSec=2 stays gentle).
StartLimitIntervalSec=0

[Service]
User=tazko
Group=tazko
EnvironmentFile=/etc/tazko/tazko.env
WorkingDirectory=/var/lib/tazko
UMask=0077
# Releases are read-only and byte-compiled at install time.
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/tazko/current/.venv/bin/tazko serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/tazko
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
