[Unit]
Description=Tazko nightly backup
After=tazko.service

[Service]
Type=oneshot
User=tazko
Group=tazko
EnvironmentFile=/etc/tazko/tazko.env
# Releases are read-only and byte-compiled at install time.
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/tazko/current/.venv/bin/tazko backup --data /var/lib/tazko/data --to /var/backups/tazko --keep-days 30
ExecStartPost=/opt/tazko/current/.venv/bin/tazko check --data /var/backups/tazko/latest
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/tazko
ReadOnlyPaths=/var/lib/tazko
