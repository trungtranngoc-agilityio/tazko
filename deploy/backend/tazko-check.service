[Unit]
Description=Tazko: check every database is sound and usable by the current release (tazko-release starts it)

[Service]
Type=oneshot
User=tazko
Group=tazko
# No tazko.env: these commands need no Google settings, only no .env reading (D16).
Environment=TAZKO_ENV=production
WorkingDirectory=/var/lib/tazko
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/tazko/current/.venv/bin/tazko check --data /var/lib/tazko/data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
# Writable data: SQLite needs the WAL index (-shm) to read a WAL database (D37).
ReadWritePaths=/var/lib/tazko
