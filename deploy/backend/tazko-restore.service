[Unit]
Description=Tazko: restore the pre-release snapshot (tazko-release starts it with the service stopped)
Conflicts=tazko.service

[Service]
Type=oneshot
User=tazko
Group=tazko
# No tazko.env: these commands need no Google settings, only no .env reading.
Environment=TAZKO_ENV=production
WorkingDirectory=/var/lib/tazko
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/usr/local/lib/tazko/restore-pre-release.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/tazko
ReadOnlyPaths=/var/backups/tazko
