# Build-time settings for the web app (Vite reads VITE_* only).
# Copy to .env.production.local for a local production build, or set it as an
# environment variable in the Cloudflare Pages project.

# Base URL of the API server. Leave empty in development (Vite proxies to :8791).
VITE_API_URL=https://tazko-api-dev.hugepigstudio.com
