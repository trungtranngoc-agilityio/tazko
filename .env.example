# Copy to .env for local development only. Production settings live in
# /etc/tazko/tazko.env on the server and are set by the owner, never by the agent.
TAZKO_HOST=127.0.0.1
TAZKO_PORT=8791
# Public URL of this API (production: https://tazko-api-dev.hugepigstudio.com).
TAZKO_PUBLIC_URL=http://127.0.0.1:8791
# Origin of the web app; the only origin allowed by CORS and the Origin check.
# Production: https://tazko-dev.hugepigstudio.com. Dev: the Vite server.
TAZKO_WEB_ORIGIN=http://localhost:5173
TAZKO_DATA_DIR=./data
# Log level: DEBUG, INFO, WARNING, ERROR.
TAZKO_LOG=INFO

# Google OIDC web client (P0-2). Leave empty until M1-04.
TAZKO_GOOGLE_CLIENT_ID=
TAZKO_GOOGLE_CLIENT_SECRET=

# 32+ characters. Empty = a random secret file is created in the data folder on first start.
TAZKO_SECRET=

# Email (optional, M6)
TAZKO_SMTP_HOST=
TAZKO_SMTP_PORT=
TAZKO_SMTP_USER=
TAZKO_SMTP_PASSWORD=
TAZKO_MAIL_FROM=
