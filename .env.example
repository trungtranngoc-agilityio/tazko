# Copy to .env for local development only. Production settings live in
# /etc/tazko/tazko.env on the server and are set by the owner, never by the agent.
TAZKO_HOST=127.0.0.1
TAZKO_PORT=8791
TAZKO_PUBLIC_URL=http://127.0.0.1:8791
TAZKO_DATA_DIR=./data

# Google OIDC web client (P0-2). Leave empty until M1-04.
TAZKO_GOOGLE_CLIENT_ID=
TAZKO_GOOGLE_CLIENT_SECRET=

# 32+ characters. Empty = a random secret file is created in the data folder on first start.
TAZKO_SECRET=

# Email (optional, M6)
TAZKO_SMTP_HOST=
TAZKO_SMTP_PORT=
TAZKO_SMTP_USER=
TAZKO_SMTP_PASSWORD=
TAZKO_MAIL_FROM=
